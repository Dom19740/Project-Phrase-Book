# Dummy values for the automated test suite only — never real credentials. All Redis/Gemini
# network calls are mocked in tests, so these just need to be present so module-level client
# construction doesn't warn/throw; nothing here ever reaches a real service.
UPSTASH_REDIS_REST_URL=https://fake-test.upstash.io
UPSTASH_REDIS_REST_TOKEN=fake-test-token
GEMINI_API_KEY=fake-test-key
GEMINI_RETRY_BACKOFF_MS=10
